<launch>
  <arg name="mode" default="climb"/>
  <arg name="runner_config" default="$(find hex_runner)/config/$(arg mode).yaml"/>
  <arg name="backend_config" default="$(eval find('hex_isaacgym') + '/config/' + ('quad_plane.yaml' if arg('mode') == 'quad_climb' else ('plane.yaml' if arg('mode') == 'climb' else 'complex_surface4.yaml')))"/>
  <arg name="to_sim_info" default="$(find hex_runner)/config/to_sim_info.yaml"/>
  <arg name="device" default="cpu"/>
  <arg name="headless" default="false"/>
  <arg name="publish_clock" default="false"/>
  <arg name="data_root" default=""/>
  <arg name="output_dir" default=""/>
  <param if="$(arg publish_clock)" name="/use_sim_time" value="true"/>
  <node pkg="hex_runner" type="sim_launcher.py" name="hex_sim_launcher" output="screen" required="true"
        args="--runner-config '$(arg runner_config)' --backend-config '$(arg backend_config)' --to-sim-info '$(arg to_sim_info)' --device '$(arg device)' --headless $(arg headless) --publish-clock $(arg publish_clock) --data-root '$(arg data_root)' --output-dir '$(arg output_dir)'"/>
</launch>
