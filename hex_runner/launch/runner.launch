<launch>
  <arg name="mode" default="climb"/>
  <arg name="implementation" default="$(eval 'cpp' if arg('mode') == 'climb' else 'python')"/>
  <arg name="config" default="$(find hex_runner)/config/$(arg mode).yaml"/>
  <arg name="data_root" default=""/>
  <arg name="output_dir" default=""/>
  <arg name="to_sim_info" default="$(find hex_runner)/config/to_sim_info.yaml"/>
  <node pkg="hex_runner" type="$(eval {'cpp': 'runner_node_cpp', 'python': 'runner_node.py'}[arg('implementation')])" name="hex_runner" output="screen" required="true"
        args="--config '$(arg config)' --data-root '$(arg data_root)' --output-dir '$(arg output_dir)' --to-sim-info '$(arg to_sim_info)'"/>
</launch>
