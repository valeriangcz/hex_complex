<launch>
  <arg name="scene_config" default="$(find hex_isaacgym)/config/expert_climb_scene.yaml"/>
  <arg name="device" default=""/>
  <arg name="headless" default="true"/>
  <arg name="data_root" default=""/>
  <arg name="output_dir" default=""/>
  <arg name="publish_clock" default="false"/>
  <arg name="wall_rate_hz" default="100.0"/>
  <include file="$(find hex_isaacgym)/launch/expert_sim.launch" pass_all_args="true"/>
</launch>
