<launch>
  <arg name="scene_config" default="$(find hex_isaacgym)/config/expert_complex_scene.yaml"/>
  <arg name="path" default=""/>
  <!-- Empty overrides use the scene/backend YAML values. -->
  <arg name="data_root" default=""/>
  <arg name="output_dir" default=""/>
  <arg name="device" default=""/>
  <arg name="headless" default="true"/>
  <arg name="publish_clock" default="false"/>
  <arg name="wall_rate_hz" default="0.0"/>

  <node pkg="hex_isaacgym" type="expert_sim_node.py" name="hex_expert_sim" output="screen" required="true"
        args="--scene-config '$(arg scene_config)' --path '$(arg path)' --data-root '$(arg data_root)' --device '$(arg device)' --output-dir '$(arg output_dir)' --headless $(arg headless) --publish-clock $(arg publish_clock) --wall-rate-hz $(arg wall_rate_hz)"/>
</launch>

